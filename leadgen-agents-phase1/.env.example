# ---- Core ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leadgen
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DATABASE_URL=

# ---- GHL ----
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
GHL_AUTH_TYPE=bearer

# One Private Integration token per sub-account
GHL_API_KEY_GARAGE=
GHL_API_KEY_POOL=

GHL_LOCATION_ID_GARAGE=
GHL_LOCATION_ID_POOL=

# Garage pipeline + stages
GHL_PIPELINE_ID_GARAGE=
GHL_STAGE_ID_GARAGE_NEW_LEAD=
GHL_STAGE_ID_GARAGE_CONTACTED=
GHL_STAGE_ID_GARAGE_QUOTED=
GHL_STAGE_ID_GARAGE_SCHEDULED=
GHL_STAGE_ID_GARAGE_WON=
GHL_STAGE_ID_GARAGE_LOST=

# Pool pipeline + stages
GHL_PIPELINE_ID_POOL=
GHL_STAGE_ID_POOL_NEW_LEAD=
GHL_STAGE_ID_POOL_CONTACTED=
GHL_STAGE_ID_POOL_QUOTED=
GHL_STAGE_ID_POOL_SCHEDULED=
GHL_STAGE_ID_POOL_WON=
GHL_STAGE_ID_POOL_LOST=

# ---- Webhook verification ----
WEBHOOK_MODE=shared_secret
WEBHOOK_SHARED_SECRET_HEADER=x-forge-secret
GHL_WEBHOOK_SECRET=

# Native-path upgrade only (leave blank in shared_secret mode)
GHL_WEBHOOK_ED25519_PUBLIC_KEY=
GHL_WEBHOOK_RSA_PUBLIC_KEY=

# ---- Messaging / Compliance ----
DEFAULT_TIMEZONE=America/Chicago
REQUIRE_CONSENT_BEFORE_SEND=true
STOP_KEYWORDS=STOP,UNSUBSCRIBE,CANCEL,END,QUIT
QUIET_HOURS_START=20:00
QUIET_HOURS_END=08:00

# ---- Queue / Jobs ----
QUEUE_CONCURRENCY=2
JOB_RETRY_MAX=5
JOB_RETRY_BACKOFF_MS=2000
DEAD_LETTER_ENABLED=true

# ---- Embeddings ----
EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBEDDINGS_VECTOR_DIM=1536

# ---- Safety / Spend ----
DAILY_AD_SPEND_CAP_USD=0
REQUIRE_MANUAL_APPROVAL_FOR_CAMPAIGN_LAUNCH=true
FB_GROUP_AUTOPOST_ENABLED=false
