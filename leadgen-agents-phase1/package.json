{
  "name": "leadgen-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "migrate": "tsx src/db/migrate.ts",
    "dev": "tsx watch src/server/index.ts",
    "worker": "tsx watch src/queue/worker.ts",
    "start:server": "tsx src/server/index.ts",
    "start:worker": "tsx src/queue/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
